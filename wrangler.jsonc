{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buktrakr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // The app must only be reachable through the Access-protected custom domain.
  "workers_dev": false,

  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Create with: wrangler kv namespace create KV
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],

  "vars": {
    // Zero Trust -> Settings -> Custom Pages shows your team domain.
    "ACCESS_TEAM_DOMAIN": "REPLACE-TEAM.cloudflareaccess.com",
    // Access application AUD tag (Zero Trust -> Access -> Applications -> your app -> Overview).
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APP_AUD_TAG",
    "APP_URL": "https://books.example.com"
  },

  // Secrets (wrangler secret put): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET

  "routes": [{ "pattern": "books.example.com", "custom_domain": true }]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buktrakr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // The app must only be reachable through the Access-protected custom domain
  // (added in the dashboard: Settings -> Domains & Routes).
  "workers_dev": false,

  // All vars and secrets are managed in the Cloudflare dashboard
  // (Settings -> Variables and Secrets): APP_URL, ACCESS_TEAM_DOMAIN,
  // ACCESS_AUD as plaintext vars; GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET as
  // secrets. keep_vars stops git-triggered deploys from wiping them.
  "keep_vars": true,

  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Create the namespace in the dashboard (Storage & Databases -> KV) and
  // paste its ID here — this is the one value that must live in the repo.
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buktrakr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // Secrets (dashboard: Settings -> Variables and Secrets, or `wrangler
  // secret put`): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET.
  // keep_vars stops git-triggered deploys from wiping dashboard-set values.
  "keep_vars": true,

  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Deploying with the "Deploy to Cloudflare" button provisions this
  // namespace automatically. Deploying manually: create a KV namespace
  // (dashboard -> Storage & Databases -> KV) and paste its ID here.
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }]
}

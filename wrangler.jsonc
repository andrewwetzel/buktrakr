{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buktrakr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // The Worker is fully stateless — no KV, D1, or other bindings. All state
  // lives in the user's encrypted session cookie.
  //
  // Secrets (dashboard: Settings -> Variables and Secrets, or `wrangler
  // secret put`): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET.
  // keep_vars stops git-triggered deploys from wiping dashboard-set values.
  "keep_vars": true,

  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*", "/auth/*"]
  }
}

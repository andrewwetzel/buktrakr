# Copy to .dev.vars for local development (`wrangler dev`).
# .dev.vars is gitignored — never commit real values.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts session cookies. Any long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=local-dev-secret-change-me
